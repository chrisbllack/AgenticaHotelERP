# INFINEON Enterprise Platform — Environment Configuration

# Application
INFINEON_PORT=8080
INFINEON_MODE=on-premise
INFINEON_LOG_LEVEL=info

# Database
DATABASE_URL=postgres://infineon:infineon@localhost:5432/infineon?sslmode=disable

# JWT Authentication
INFINEON_JWT_SECRET=change-this-to-a-secure-random-string

# Cloud Sync (for hybrid/cloud mode)
INFINEON_CLOUD_URL=
INFINEON_PROPERTY_TOKEN=

# Licensing
INFINEON_LICENSE_FILE=

# Backup
INFINEON_BACKUP_DIR=/var/lib/infineon/backups

# SMTP (for email notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@infineon.local
